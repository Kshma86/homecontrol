[Unit]
Description=HomeControl MQTT legacy source restriction
After=docker.service
Requires=docker.service
PartOf=docker.service
Before=homecontrol-hostops.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /srv/docker/homecontrol/scripts/access_runtime/hc-f10-20261031-r12/scripts/access_release/network.py --policy /srv/docker/homecontrol/infra/ssh/hc-f10-20261031-r12/network-policy.json --apply
[Install]
WantedBy=multi-user.target
