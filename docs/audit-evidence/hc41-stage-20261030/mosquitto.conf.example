# HC-41 candidate; deploy only after password hashing and network verification.
per_listener_settings true
persistence true
persistence_location /mosquitto/data/
log_dest stdout
log_type error
log_type warning
log_type notice

listener 1884 0.0.0.0
allow_anonymous false
password_file /mosquitto/config/credentials/passwords
acl_file /mosquitto/config/authenticated.acl

listener 1883 0.0.0.0
allow_anonymous true
acl_file /mosquitto/config/legacy.acl
