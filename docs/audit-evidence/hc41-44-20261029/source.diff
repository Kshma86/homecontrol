+
+    def target(self,ref):
+        # Exact allowlist key/name or the complete advertised ID; no prefix guessing.
+        if not isinstance(ref,str) or not re.fullmatch(r'[a-zA-Z0-9_-]{1,100}',ref):
+            raise ValueError('Invalid container target')
+        rows=self.inventory()
