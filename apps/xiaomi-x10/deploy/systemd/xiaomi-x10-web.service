[Unit]
Description=Xiaomi X10 HomeControl web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homecontrol
WorkingDirectory=/opt/xiaomi-x10
EnvironmentFile=/opt/xiaomi-x10/.env
ExecStart=/opt/xiaomi-x10/.venv/bin/python /opt/xiaomi-x10/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
