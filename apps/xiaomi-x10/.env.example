# Xiaomi X10 HomeControl service settings
X10_MQTT_HOST=192.168.1.133
X10_MQTT_PORT=1883
X10_BASE_TOPIC=homecontrol/xiaomi_x10

X10_ROBOT_IP=192.168.1.157
X10_ROBOT_TOKEN=replace_with_robot_token
X10_MIIOCLI=/home/homecontrol/.local/bin/miiocli

X10_APP_HOST=0.0.0.0
X10_APP_PORT=5050
X10_APP_DEBUG=0

X10_MAP_OUTPUT_DIR=/opt/xiaomi-x10/x10_maps
X10_MAP_SCRIPT=/opt/xiaomi-x10/xiaomi_x10_map.py
X10_MAPS_INDEX=/opt/xiaomi-x10/x10_maps/maps_index.json
X10_XIAOMI_CLOUD_AUTH=/opt/xiaomi-x10/x10_maps/xiaomi_cloud_auth.json
X10_XIAOMI_CLOUD_COUNTRY=de

X10_POLL_IDLE_SEC=60
X10_POLL_CLEANING_SEC=10
X10_MAP_CHECK_CLEANING_SEC=20
X10_SCHEDULER_WATCH_SEC=10

X10_ROOM_CLEAN_TASK_ID=1
X10_ROOM_CLEAN_DELAY_MIN=2
X10_ROOM_CLEAN_SUCTION=3
X10_ROOM_CLEAN_PARAM=3
